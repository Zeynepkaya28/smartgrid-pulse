# Public (sent to the browser). Anon key only: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix these with NEXT_PUBLIC_.
# /api/sim publishes simulator commands. Leave MQTT_HOST empty to disable simulation.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
