# MQTT broker (local: Mosquitto 1883, HiveMQ Cloud: <cluster>.s1.eu.hivemq.cloud 8883 + TLS)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# Supabase Postgres (local default from `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Supabase Realtime Broadcast (server only)
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=
