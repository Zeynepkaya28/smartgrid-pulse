# MQTT broker (local: Mosquitto 1883; production: your own broker on 8883 with MQTT_TLS=true)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=smartgrid-worker

# Supabase Postgres.
# Local (`supabase start`): postgresql://postgres:postgres@127.0.0.1:54422/postgres
# Production: Supavisor SESSION pooler, port 5432 (IPv4). COPY does not work through the
# transaction pooler on 6543:
#   postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Supabase Realtime Broadcast (server only, never expose to the browser)
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=

# /healthz port (Railway sets PORT automatically, which takes precedence)
HEALTH_PORT=8080
LOG_LEVEL=INFO
