# MQTT broker (local: Mosquitto, production: HiveMQ Cloud mqtts://...:8883)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Supabase Postgres (local default from `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Realtime Broadcast (server only)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
