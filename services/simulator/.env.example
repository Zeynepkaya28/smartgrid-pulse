# MQTT broker
# Local Mosquitto: MQTT_HOST=localhost, MQTT_PORT=1883, MQTT_TLS=false
# Any managed/self-hosted broker with TLS (EMQX Cloud, HiveMQ, ...):
#                  MQTT_HOST=<broker-host>, MQTT_PORT=8883, MQTT_TLS=true + username/password
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=smartgrid-simulator

# Fleet
DEVICE_COUNT=12
PUBLISH_HZ=1
# Optional fixed seed for a reproducible fleet
SIM_SEED=

# /healthz port (Railway sets PORT automatically, which takes precedence)
HEALTH_PORT=8080
LOG_LEVEL=INFO
