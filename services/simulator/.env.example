# MQTT broker
# Local Mosquitto: MQTT_HOST=localhost, MQTT_PORT=1883, MQTT_TLS=false
# HiveMQ Cloud:    MQTT_HOST=<cluster>.s1.eu.hivemq.cloud, MQTT_PORT=8883, MQTT_TLS=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=smartgrid-simulator

# Fleet
DEVICE_COUNT=12
PUBLISH_HZ=1
# Optional fixed seed for a reproducible fleet
SIM_SEED=

# /healthz port (Railway sets PORT automatically, which takes precedence)
HEALTH_PORT=8080
LOG_LEVEL=INFO
